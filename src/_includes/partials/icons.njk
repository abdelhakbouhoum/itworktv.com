{#- Inline SVG symbol sprite. Included once at the top of <body>, BEFORE any
     <use> reference (header, footer, buttons). Symbols inherit currentColor,
     so icon colour follows the surrounding text colour. Kept tiny and static
     so it costs nothing on TBT. -#}
<svg xmlns="http://www.w3.org/2000/svg" class="icon-sprite" aria-hidden="true" focusable="false">
  {# logo mark (monitor + </> + stand), 24 grid #}
  <symbol id="i-logo" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3.5" y="4.5" width="17" height="11.5" rx="2.2"/>
      <polyline points="9.8,8.2 7.2,10.25 9.8,12.3"/>
      <line x1="14.2" y1="8" x2="13" y2="12.5"/>
      <polyline points="14.2,8.2 16.8,10.25 14.2,12.3"/>
      <line x1="12" y1="16" x2="12" y2="18.2"/>
      <line x1="9.4" y1="19.8" x2="14.6" y2="19.8"/>
    </g>
  </symbol>
  {# play mark (TV/channel hint) #}
  <symbol id="i-play" viewBox="0 0 24 24">
    <path d="M8.5 5.8v12.4a1 1 0 0 0 1.52.85l10-6.2a1 1 0 0 0 0-1.7l-10-6.2a1 1 0 0 0-1.52.85Z" fill="currentColor" stroke="none"/>
  </symbol>
  {# rss feed #}
  <symbol id="i-rss" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M4.5 12a8 8 0 0 1 8 8"/>
      <path d="M4.5 5.5A14.5 14.5 0 0 1 19 20"/>
    </g>
    <circle cx="5.2" cy="18.8" r="1.9" fill="currentColor" stroke="none"/>
  </symbol>
  {# sun (switch to light) #}
  <symbol id="i-sun" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.2"/>
      <path d="M12 2.5v2.3M12 19.2v2.3M2.5 12h2.3M19.2 12h2.3M5.2 5.2l1.65 1.65M17.15 17.15l1.65 1.65M5.2 18.8l1.65-1.65M17.15 6.85l1.65-1.65"/>
    </g>
  </symbol>
  {# moon (switch to dark) #}
  <symbol id="i-moon" viewBox="0 0 24 24">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
  </symbol>
  {# search #}
  <symbol id="i-search" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="11" cy="11" r="7.2"/>
      <line x1="16.4" y1="16.4" x2="21" y2="21"/>
    </g>
  </symbol>
  {# copy #}
  <symbol id="i-copy" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="9" y="9" width="12" height="12" rx="2.2"/>
      <path d="M5.5 15H4.5A1.5 1.5 0 0 1 3 13.5V4.5A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5v1"/>
    </g>
  </symbol>
  {# check #}
  <symbol id="i-check" viewBox="0 0 24 24">
    <polyline points="5,12.8 10,17.8 19.5,6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
  </symbol>
  {# external link #}
  <symbol id="i-external" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18.5 13.5V19a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 19V6.5A1.5 1.5 0 0 1 5 5h5.5"/>
      <polyline points="15,3.5 20.5,3.5 20.5,9"/>
      <line x1="10.5" y1="13.5" x2="20.5" y2="3.5"/>
    </g>
  </symbol>
</svg>
