{#- Pagination: numbered pages + "Newer"/"Older" arrow links with
     rel=prev / rel=next (PLAN §3). Page 1 is the collection URL itself.
     Usage:  {% import "partials/pagination.njk" as pag %}
             {{ pag.render({ baseUrl: "/posts/", currentPage: 2, totalPages: 5,
                              prevUrl: "/posts/", nextUrl: "/posts/page/3/" }) }}
     Only rendered when totalPages > 1. -#}
{% macro render(state) -%}
{%- set total = state.totalPages -%}
{%- set current = state.currentPage -%}
{%- if total and total > 1 -%}
<nav class="pagination" aria-label="Pagination">
  {%- if state.prevUrl %}
    <a class="pagination__link" rel="prev" href="{{ state.prevUrl }}">&larr; Newer</a>
  {%- endif %}
  <span class="visually-hidden">Page {{ current }} of {{ total }}</span>
  {%- for n in range(1, total + 1) %}
    {%- if n == current %}
      <span class="pagination__num" aria-current="page">{{ n }}</span>
    {%- else %}
      <a class="pagination__num" href="{{ state.baseUrl if n == 1 else (state.baseUrl ~ "page/" ~ n ~ "/") }}">{{ n }}</a>
    {%- endif %}
  {%- endfor %}
  {%- if state.nextUrl %}
    <a class="pagination__link" rel="next" href="{{ state.nextUrl }}">Older &rarr;</a>
  {%- endif %}
</nav>
{%- endif -%}
{%- endmacro %}
