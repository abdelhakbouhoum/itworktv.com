{#- Site header: brand (inline two-tone SVG mark + wordmark), primary nav
     (from the `nav` data file when present, with a static fallback), search,
     RSS and theme toggle. No JS: on narrow screens the nav simply wraps to a
     second line instead of collapsing into a menu. -#}
<header class="site-header">
  <div class="site-header__inner container">
    <a class="brand" href="/">
      {# Keep in sync with src/assets/img/logo.svg (standalone file). #}
      <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <ellipse cx="16" cy="17" rx="13.4" ry="4.8" transform="rotate(-16 16 17)" stroke="var(--accent, #0E7490)" stroke-width="1.3" opacity="0.55"/>
        <g stroke="var(--accent, #0E7490)" stroke-width="1.5">
          <circle cx="8.5" cy="8.5" r="3.4"/>
          <path d="M8.5 4.2v-1.4M8.5 12.8v1.4M4.2 8.5H2.8M12.8 8.5h1.4M5.5 5.5 4.4 4.4M11.5 5.5l1.1-1.1M5.5 11.5l-1.1 1.1M11.5 11.5l1.1 1.1"/>
        </g>
        <circle cx="8.5" cy="8.5" r="1.1" fill="var(--accent, #0E7490)" stroke="none"/>
        <rect x="13" y="10" width="15.5" height="11" rx="2.5" fill="var(--accent, #0E7490)" stroke="none"/>
        <g stroke="var(--accent-contrast, #FFFFFF)" stroke-width="1.7">
          <polyline points="17.8,13.4 15.2,15.5 17.8,17.6"/>
          <line x1="20.9" y1="13.2" x2="19.4" y2="17.8"/>
          <polyline points="22.6,13.4 25.2,15.5 22.6,17.6"/>
        </g>
        <g stroke="var(--text, #172435)" stroke-width="1.8">
          <line x1="20.75" y1="21" x2="20.75" y2="23.4"/>
          <line x1="17.4" y1="24.6" x2="24.1" y2="24.6"/>
        </g>
      </svg>
      <span class="brand__name">IT Work <span class="brand__tv">TV</span></span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      {%- if nav and nav.length -%}
        {%- for item in nav -%}
        <a href="{{ item.url }}">{{ item.label }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="/posts/">Posts</a>
        <a href="/tags/">Tags</a>
        <a href="/about/">About</a>
      {%- endif -%}
      <a href="/search/">
        <svg aria-hidden="true" focusable="false"><use href="#i-search"></use></svg>
        <span>Search</span>
      </a>
      <a class="site-nav__rss" href="/feed.xml" title="RSS feed" aria-label="RSS feed">
        <svg aria-hidden="true" focusable="false"><use href="#i-rss"></use></svg>
      </a>
      {% include "partials/theme-toggle.njk" %}
    </nav>
  </div>
</header>
