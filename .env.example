# IT Work TV — environment variable template
#
# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored — NEVER commit it, and NEVER put a real value in
# this file. This file holds REPLACE_ME / safe defaults only
# (CLAUDE.md hard rule 2: no secrets in the repo).
#
# NOTE: scripts/ (owned by eleventy-engineer / devops-engineer) did not
# exist yet when this file was written (Phase 1, 2026-10-04). The names
# below are the expected contract from PLAN.md (R6, §1.2, P2.11) and the
# devops-engineer brief; confirm each name against the script that reads
# it when the scripts land, and update this file in the same commit.
#
# What each script reads:
#   scripts/img-optimize.mjs  -> IMAGE_BASE_URL
#   scripts/img-upload.mjs    -> CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN

# ---------------------------------------------------------------------------
# Image base URL
# ---------------------------------------------------------------------------
# Where `r2:` image URLs resolve. Production: the R2 bucket behind
# img.itworktv.com (SETUP.md steps 5-6). In local dev you may point this at
# a folder instead (e.g. ./images-out) so `npm run dev` can preview images
# before anything is uploaded.
IMAGE_BASE_URL=https://img.itworktv.com

# ---------------------------------------------------------------------------
# Cloudflare R2 credentials (scripts/img-upload.mjs / wrangler)
# ---------------------------------------------------------------------------
# Your Cloudflare ACCOUNT ID (16 hex chars). Where it comes from:
# Cloudflare dashboard, top-right account menu -> "View account" (or any
# R2 bucket settings page). It is an identifier, not a secret.
CLOUDFLARE_ACCOUNT_ID=REPLACE_ME

# R2 API token. Created in the dashboard: R2 -> bucket itworktv-images ->
# Settings -> Manage API tokens, API selector = S3 API (NOT the Cloudflare
# REST API), permission exactly "Object Read & Write". See SETUP.md step 7.
# SHOWN ONCE AT CREATION — store it here immediately.
CLOUDFLARE_API_TOKEN=REPLACE_ME

# ---------------------------------------------------------------------------
# NOT .env variables — documented here only so nobody hunts for them
# ---------------------------------------------------------------------------
# CF_PAGES_DEPLOY_HOOK   -> GitHub Actions *repository secret* (not .env).
#                           The Pages deploy hook URL; SETUP.md step 8.
# Web Analytics token    -> no token at all: Cloudflare auto-injects the
#                           beacon via Pages Metrics (owner's confirmed
#                           choice). If manual embedding is ever needed the
#                           token is a LITERAL in data-cf-beacon inside
#                           head.njk — an env var does not exist for it
#                           (PLAN R9).
